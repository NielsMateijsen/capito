      "it": "Mi chiamo Sam. E Lei?",
      "nl": ["Ik heet Sam. En u?"],
      "register": "formal",
      "uses": ["v_chiamarsi", "w_e"],
      "audioText": null
    },
    {
      "id": "s_u02_006",
      "it": "Mi chiamo Giulia. Piacere!",
      "nl": ["Ik heet Giulia. Aangenaam!", "Ik heet Giulia. Leuk je te ontmoeten!"],
      "register": "informal",
      "uses": ["v_chiamarsi", "w_piacere"],
      "audioText": null
    },
    {
      "id": "s_u02_007",
      "it": "Sono la signora Rossi. Piacere.",
      "nl": ["Ik ben mevrouw Rossi. Aangenaam."],
      "register": "neutral",
      "uses": ["v_essere", "w_signora", "w_piacere"],
      "audioText": null
    },
    {
      "id": "s_u02_008",
      "it": "Come si chiama, signora?",
      "nl": ["Hoe heet u, mevrouw?", "Wat is uw naam, mevrouw?"],
      "register": "formal",
      "uses": ["w_come", "v_chiamarsi", "w_signora"],
      "audioText": null,
      "cloze": [{ "target": "si chiama", "hint": "chiamarsi" }]
    },
    {
      "id": "s_u02_041",
      "it": "Piacere, signora.",
      "nl": ["Aangenaam, mevrouw.", "Leuk u te ontmoeten, mevrouw."],
      "register": "formal",
      "uses": ["w_piacere", "w_signora"],
      "audioText": null
    },
    {
      "id": "s_u02_009",
      "it": "Sono di Utrecht.",
