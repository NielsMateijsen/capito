    {
      "id": "s_u02_001",
      "it": "Mi chiamo Sam.",
      "nl": ["Ik heet Sam.", "Mijn naam is Sam."],
      "register": "neutral",
      "uses": ["v_chiamarsi"],
      "audioText": null,
      "cloze": [{ "target": "Mi chiamo", "hint": "chiamarsi" }]
    },
    {
      "id": "s_u02_002",
      "it": "Ciao! Come ti chiami?",
      "nl": ["Hoi! Hoe heet je?", "Hoi! Hoe heet jij?"],
      "register": "informal",
      "uses": ["w_ciao", "w_come", "v_chiamarsi"],
      "audioText": null,
      "cloze": [{ "target": "ti chiami", "hint": "chiamarsi" }]
    },
    {
      "id": "s_u02_003",
      "it": "Mi chiamo Sam. E tu?",
      "nl": ["Ik heet Sam. En jij?"],
