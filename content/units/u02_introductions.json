      "uses": ["v_chiamarsi", "w_e"],
      "audioText": null,
      "cloze": [{ "target": "Mi chiamo", "hint": "chiamarsi" }]
    },
    {
      "id": "s_u02_004",
      "it": "Buonasera! Lei come si chiama?",
      "nl": ["Goedenavond! Hoe heet u?", "Goedenavond! Wat is uw naam?"],
      "register": "formal",
      "uses": ["w_buonasera", "w_come", "v_chiamarsi"],
