      "cloze": [{ "target": "sei", "hint": "essere" }]
    },
    {
      "id": "s_u02_011",
      "it": "Piacere, Giulia! Di dove sei?",
      "nl": ["Aangenaam, Giulia! Waar kom je vandaan?", "Leuk je te ontmoeten, Giulia! Waar kom je vandaan?"],
      "register": "informal",
      "uses": ["w_piacere", "w_di", "w_dove", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_045",
      "it": "Buonasera! Lei di dov'è?",
      "nl": ["Goedenavond! Waar komt u vandaan?"],
      "register": "formal",
      "uses": ["w_buonasera", "w_di", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_046",
      "it": "Sono di Utrecht, signora.",
      "nl": ["Ik kom uit Utrecht, mevrouw."],
      "register": "formal",
      "uses": ["v_essere", "w_di", "w_signora"],
      "audioText": null,
      "cloze": [{ "target": "Sono", "hint": "essere" }]
    },
    {
      "id": "s_u02_047",
      "it": "Ciao, Sam! Di dove sei?",
      "nl": ["Hoi, Sam! Waar kom je vandaan?", "Hoi, Sam! Waar kom jij vandaan?"],
      "register": "informal",
      "uses": ["w_ciao", "w_di", "w_dove", "v_essere"],
      "audioText": null,
      "cloze": [{ "target": "sei", "hint": "essere" }]
    },
    {
      "id": "s_u02_012",
      "it": "Sono di Bologna. E tu?",
      "nl": ["Ik kom uit Bologna. En jij?"],
      "register": "informal",
      "uses": ["v_essere", "w_di", "w_e"],
      "audioText": null
    },
    {
      "id": "s_u02_013",
      "it": "Sono olandese.",
      "nl": ["Ik ben Nederlands.", "Ik ben Nederlander.", "Ik ben Nederlandse."],
      "register": "neutral",
      "uses": ["v_essere", "w_olandese"],
      "audioText": null
    },
    {
      "id": "s_u02_014",
      "it": "Sono olandese, di Utrecht.",
      "nl": ["Ik ben Nederlander, uit Utrecht.", "Ik ben Nederlands, uit Utrecht."],
      "register": "neutral",
      "uses": ["v_essere", "w_olandese", "w_di"],
      "audioText": null
    },
    {
      "id": "s_u02_015",
      "it": "Marco è italiano.",
      "nl": ["Marco is Italiaans.", "Marco is Italiaan."],
      "register": "neutral",
      "uses": ["v_essere", "w_italiano"],
      "audioText": null,
      "cloze": [{ "target": "è", "hint": "essere" }]
    },
    {
      "id": "s_u02_016",
      "it": "Giulia è italiana.",
      "nl": ["Giulia is Italiaans.", "Giulia is een Italiaanse."],
      "register": "neutral",
      "uses": ["v_essere", "w_italiana"],
      "audioText": null
    },
    {
      "id": "s_u02_017",
      "it": "Sei italiana, Giulia?",
      "nl": ["Ben je Italiaans, Giulia?", "Ben jij Italiaans, Giulia?"],
      "register": "informal",
      "uses": ["v_essere", "w_italiana"],
      "audioText": null,
      "cloze": [{ "target": "Sei", "hint": "essere" }]
    },
    {
      "id": "s_u02_018",
      "it": "Sì, sono italiana.",
      "nl": ["Ja, ik ben Italiaans.", "Ja, ik ben Italiaanse."],
      "register": "neutral",
      "uses": ["w_si", "v_essere", "w_italiana"],
      "audioText": null
    },
    {
      "id": "s_u02_019",
      "it": "Piacere! Lei è inglese?",
      "nl": ["Aangenaam! Bent u Engels?", "Aangenaam! Bent u Engelsman?", "Leuk u te ontmoeten! Bent u Engels?"],
      "register": "formal",
      "uses": ["w_piacere", "v_essere", "w_inglese"],
      "audioText": null,
      "cloze": [{ "target": "è", "hint": "essere" }]
    },
    {
      "id": "s_u02_020",
      "it": "No, sono olandese.",
      "nl": ["Nee, ik ben Nederlands.", "Nee, ik ben Nederlander.", "Nee, ik ben Nederlandse."],
      "register": "neutral",
      "uses": ["w_no", "v_essere", "w_olandese"],
      "audioText": null
    },
    {
      "id": "s_u02_021",
      "it": "No, non sono inglese.",
      "nl": ["Nee, ik ben niet Engels.", "Nee, ik ben geen Engelsman.", "Nee, ik ben geen Engelse."],
      "register": "neutral",
      "uses": ["w_no", "w_non", "v_essere", "w_inglese"],
      "audioText": null
    },
    {
      "id": "s_u02_042",
      "it": "Lei è inglese?",
      "nl": ["Bent u Engels?", "Bent u Engelsman?"],
      "register": "formal",
      "uses": ["v_essere", "w_inglese"],
      "audioText": null,
      "cloze": [{ "target": "è", "hint": "essere" }]
    },
    {
      "id": "s_u02_022",
      "it": "E dove abiti?",
      "nl": ["En waar woon je?", "En waar woon jij?"],
      "register": "informal",
      "uses": ["w_e", "w_dove", "v_abitare"],
      "audioText": null,
      "cloze": [{ "target": "abiti", "hint": "abitare" }]
    },
    {
      "id": "s_u02_023",
      "it": "E dove abita?",
      "nl": ["En waar woont u?"],
      "register": "formal",
      "uses": ["w_e", "w_dove", "v_abitare"],
      "audioText": null,
      "cloze": [{ "target": "abita", "hint": "abitare" }]
    },
    {
      "id": "s_u02_024",
      "it": "Abito a Bologna.",
      "nl": ["Ik woon in Bologna."],
      "register": "neutral",
      "uses": ["v_abitare", "w_a"],
      "audioText": null,
      "cloze": [{ "target": "Abito", "hint": "abitare" }]
    },
    {
      "id": "s_u02_025",
      "it": "Abito qui a Bologna.",
      "nl": ["Ik woon hier in Bologna."],
      "register": "neutral",
      "uses": ["v_abitare", "w_qui", "w_a"],
      "audioText": null
    },
    {
      "id": "s_u02_026",
      "it": "Adesso abito a Bologna.",
      "nl": ["Nu woon ik in Bologna.", "Ik woon nu in Bologna."],
      "register": "neutral",
      "uses": ["w_adesso", "v_abitare", "w_a"],
      "audioText": null,
      "cloze": [{ "target": "abito", "hint": "abitare" }]
    },
    {
      "id": "s_u02_027",
      "it": "E Lei, signora, dove abita?",
      "nl": ["En u, mevrouw, waar woont u?", "En waar woont u, mevrouw?"],
      "register": "formal",
      "uses": ["w_e", "w_signora", "w_dove", "v_abitare"],
      "audioText": null,
      "cloze": [{ "target": "abita", "hint": "abitare" }]
    },
    {
      "id": "s_u02_028",
      "it": "Anche Marco abita qui.",
      "nl": ["Marco woont hier ook.", "Ook Marco woont hier."],
      "register": "neutral",
      "uses": ["w_anche", "v_abitare", "w_qui"],
      "audioText": null,
      "cloze": [{ "target": "abita", "hint": "abitare" }]
    },
    {
      "id": "s_u02_029",
      "it": "Anche tu sei di Bologna?",
      "nl": ["Kom jij ook uit Bologna?", "Kom je ook uit Bologna?"],
      "register": "informal",
      "uses": ["w_anche", "v_essere", "w_di"],
      "audioText": null
    },
    {
      "id": "s_u02_030",
      "it": "Sì, anche Luca è italiano.",
      "nl": ["Ja, Luca is ook Italiaans.", "Ja, Luca is ook Italiaan."],
      "register": "neutral",
      "uses": ["w_si", "w_anche", "v_essere", "w_italiano"],
      "audioText": null
    },
    {
      "id": "s_u02_031",
      "it": "No, sono olandese, ma abito qui.",
      "nl": ["Nee, ik ben Nederlander, maar ik woon hier.", "Nee, ik ben Nederlands, maar ik woon hier."],
      "register": "neutral",
      "uses": ["w_no", "v_essere", "w_olandese", "w_ma", "v_abitare", "w_qui"],
      "audioText": null
    },
    {
      "id": "s_u02_032",
      "it": "Non sono italiano, ma adesso abito qui.",
      "nl": ["Ik ben geen Italiaan, maar nu woon ik hier.", "Ik ben niet Italiaans, maar ik woon nu hier."],
      "register": "neutral",
      "uses": ["w_non", "v_essere", "w_italiano", "w_ma", "w_adesso", "v_abitare", "w_qui"],
      "audioText": null
    },
    {
      "id": "s_u02_033",
      "it": "Luca è di Roma, ma adesso abita qui.",
      "nl": ["Luca komt uit Rome, maar hij woont nu hier.", "Luca komt uit Rome, maar nu woont hij hier."],
      "register": "neutral",
      "uses": ["v_essere", "w_di", "w_ma", "w_adesso", "v_abitare", "w_qui"],
      "audioText": null
    },
    {
      "id": "s_u02_034",
      "it": "Questo è Marco.",
      "nl": ["Dit is Marco."],
      "register": "neutral",
      "uses": ["w_questo", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_035",
      "it": "Sam, questo è Marco.",
      "nl": ["Sam, dit is Marco."],
      "register": "neutral",
      "uses": ["w_questo", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_036",
      "it": "Ciao, Marco! Piacere.",
      "nl": ["Hoi, Marco! Aangenaam.", "Hoi, Marco! Leuk je te ontmoeten."],
      "register": "informal",
      "uses": ["w_ciao", "w_piacere"],
      "audioText": null
    },
    {
      "id": "s_u02_037",
      "it": "Questa è Giulia.",
      "nl": ["Dit is Giulia."],
      "register": "neutral",
      "uses": ["w_questa", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_038",
      "it": "Piacere, signora. Questa è Giulia.",
      "nl": ["Aangenaam, mevrouw. Dit is Giulia."],
      "register": "formal",
      "uses": ["w_piacere", "w_signora", "w_questa", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_039",
      "it": "Sì, questa è la signora Rossi.",
      "nl": ["Ja, dit is mevrouw Rossi."],
      "register": "neutral",
      "uses": ["w_si", "w_questa", "v_essere", "w_signora"],
      "audioText": null
    },
    {
      "id": "s_u02_043",
      "it": "Abito qui. Signora, questa è Giulia.",
      "nl": ["Ik woon hier. Mevrouw, dit is Giulia."],
      "register": "formal",
      "uses": ["v_abitare", "w_qui", "w_signora", "w_questa", "v_essere"],
      "audioText": null
    },
    {
      "id": "s_u02_044",
      "it": "Piacere, Giulia!",
      "nl": ["Aangenaam, Giulia!", "Leuk je te ontmoeten, Giulia!"],
      "register": "neutral",
      "uses": ["w_piacere"],
      "audioText": null
    },
    {
      "id": "s_u02_040",
      "it": "Questo è Sam. Non è inglese, è olandese.",
      "nl": ["Dit is Sam. Hij is niet Engels, hij is Nederlands.", "Dit is Sam. Hij is geen Engelsman, hij is Nederlander."],
      "register": "neutral",
      "uses": ["w_questo", "v_essere", "w_non", "w_inglese", "w_olandese"],
