{
  "schema": 1,
  "session": {
    "maxReviewsPerSession": 30,
    "newCardsPerDay": 10,
    "minNewCardsPerDay": 1,
    "maxNewCardsPerDay": 50,
    "minOldMaterialRatio": 0.3,
    "maxSameTypeInRow": 3
  },
  "backlog": {
    "maxDueShownPerDay": 40,
    "order": "most-overdue-first",
    "pauseNewCardsAboveDue": 60,
    "returnAfterDays": 7,
    "returnMaxSessionReviews": 20
