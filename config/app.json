{
  "schema": 2,
  "session": {
    "maxSameTypeInRow": 3,
    "excludedTypes": ["flashcard", "cloze", "mc-sentence", "mc-word"],
    "timeZone": "Europe/Amsterdam"
  },
  "lesson": {
    "itemsPerLesson": 3,
    "minItemsPerLesson": 1,
    "maxItemsPerLesson": 8,
    "maxStepsPerItemPerLesson": 2,
    "maxFinishItemsPerLesson": 6,
    "maxReviewsPerLesson": 4,
    "newReviewCardsPerLesson": 2
  },
  "refresh": {
    "maxCards": 15,
    "prominentAboveDueItems": 10
  },
  "streak": {
    "minRefreshAnswers": 5
  },
  "ladder": {
    "stages": ["mc-sentence", "mc-word", "cloze-word", "translate-nl-it"],
    "passResults": ["correct", "good", "easy"],
    "dropOnWrong": 1,
    "minGapSameItem": 2,
    "optionCount": 4,
    "minSentencesPerItem": 3,
    "introAutoplay": true
  },
  "lapse": {
    "retypeCorrectAnswer": true,
    "reinsertInSession": true,
    "reinsertAfterCards": 4
  },
  "leech": {
    "lapseThreshold": 6,
    "showExtraContext": true
  },
  "grading": {
    "correct": 4,
    "almost": 3,
    "hintUsed": 3,
    "wrong": 1,
    "flashcard": { "again": 1, "good": 4, "easy": 5 }
  },
  "srs": {
    "algorithm": "sm2",
    "startEase": 2.5,
    "minEase": 1.3,
    "maxIntervalDays": 180
  },
  "exam": {
    "itemCount": 15,
    "unitShare": 0.6,
    "passThreshold": 0.8,
    "passResults": ["correct", "almost"],
    "itemTypes": ["translate-nl-it", "conjugate"],
    "allowHints": false
  },
  "checker": {
    "typoMinLength": 5,
    "typoMaxDistance": 1
  },
  "backup": {
    "reminderDays": 14,
    "requestPersistentStorage": true
  }
}
